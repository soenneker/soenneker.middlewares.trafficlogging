<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Features>$(Features);runtime-async=on</Features>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Middleware that logs the full HTTP request and response, including headers and body, using buffered memory streams.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Middlewares.TrafficLogging</AssemblyName>
        <PackageId>Soenneker.Middlewares.TrafficLogging</PackageId>
        <PackageTags>middlewares trafficlogging traffic http requests responses middleware httpclient logging trafficloggingmiddleware util csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2025-2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.middlewares.trafficlogging</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.middlewares.trafficlogging</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <PackageReleaseNotes Condition="'$(PACKAGE_RELEASE_NOTES)' != ''">
            $(PACKAGE_RELEASE_NOTES)
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.Stream" Version="11.0.180" />
        <PackageReference Include="Soenneker.Extensions.String" Version="11.0.813" />
        <PackageReference Include="Soenneker.Extensions.Task" Version="11.0.142" />
        <PackageReference Include="Soenneker.Extensions.ValueTask" Version="11.0.135" />
        <PackageReference Include="Soenneker.Utils.PooledStringBuilders" Version="11.0.45" />
    </ItemGroup>
</Project>
